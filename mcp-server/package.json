{
  "name": "music21-cloudflare-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "cf:configure-access": "node ./scripts/configure-access.mjs",
    "cf:deploy": "node ./scripts/deploy.mjs deploy",
    "cf:sync-secrets": "node ./scripts/publish-secrets.mjs",
    "cf:sync-secrets:dry-run": "node ./scripts/publish-secrets.mjs --dry-run",
    "deploy": "node ./scripts/deploy.mjs deploy",
    "dev": "wrangler dev",
    "test": "node --test src/*.test.ts scripts/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "@cloudflare/workers-oauth-provider": "0.10.3",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.21.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260823.1",
    "@types/node": "26.0.1",
    "typescript": "6.0.3",
    "wrangler": "4.125.0"
  }
}
