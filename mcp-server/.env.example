# Local-only Cloudflare deploy settings for the existing music21 MCP Worker.
# Copy to mcp-server/.env and fill in real values. Do not commit .env.

# Wrangler authentication. The same CLOUDFLARE_* names work as in the EARL MCP
# delivery .env. Wrangler also reads these from the process environment.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Public Worker URL used as the Access OIDC redirect base. After the first
# deploy this is usually https://music21-mcp.<workers-subdomain>.workers.dev
MUSIC21_MCP_PUBLIC_BASE_URL=https://music21-mcp.<your-workers-subdomain>.workers.dev

# Zero Trust team domain, without a path. Example:
# https://<team-name>.cloudflareaccess.com
MUSIC21_MCP_ACCESS_TEAM_DOMAIN=https://<team-name>.cloudflareaccess.com

# Comma-separated identities allowed to complete the Access login.
ALLOWED_EMAILS=

# Optional name used by `npm run cf:configure-access` when creating or updating
# the Access SaaS OIDC application.
MUSIC21_MCP_ACCESS_APP_NAME=music21 MCP

# Values returned by the Access SaaS OIDC application. `cf:configure-access`
# can write these back into .env after it creates the app.
ACCESS_CLIENT_ID=
ACCESS_CLIENT_SECRET=
ACCESS_AUTHORIZATION_URL=
ACCESS_TOKEN_URL=
ACCESS_JWKS_URL=
ACCESS_ISSUER=
